# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it holds secrets.

# Supabase project URL (server only)
SUPABASE_URL=

# Supabase service-role key (server only, secret — never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Single admin password (server only, secret)
ADMIN_PASSWORD=

# Random salt used to hash visitor IPs for tap de-duplication (server only, secret)
TAP_SALT=

# Public app name, shown in the header and page titles
NEXT_PUBLIC_APP_NAME=Dhuri Tutors

# Public city name, used to filter listings
NEXT_PUBLIC_CITY=Dhuri

# Public site URL, used in QR codes, share links and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
